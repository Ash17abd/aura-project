# AURA 3D Learning Lab — Production Environment Configuration
# Add your Google Gemini API key (recommended) or OpenRouter API key
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Production Server Configuration
PORT=8501
HOST=0.0.0.0
ENVIRONMENT=production
ALLOWED_ORIGINS=*

# Cloud Mode Isolation (Prevents remote invocation of desktop OS agent actions)
AURA_CLOUD_DEPLOYED=1
AURA_DISABLE_LOCAL_OS=1

